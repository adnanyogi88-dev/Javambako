---
import Base from '../layouts/Base.astro';
import { getArticleImage } from '../articleImages';
import { blogPagePath } from '../blogPagination';
const { posts, currentPage, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (page) => `${base}${blogPagePath(page).slice(1)}`;
const title = currentPage === 1 ? 'Blog Java Mbako' : `Blog Java Mbako — Halaman ${currentPage}`;
---
<Base title={title} description={`Artikel dan informasi Java Mbako. Halaman ${currentPage} dari ${totalPages}.`}>
  <h1>{title}</h1>
  <div class="post-list">
    {posts.map((post) => (
      <article class="post-item">
        <img src={getArticleImage(post)} alt={post.data.imageAlt || post.data.title} loading="lazy" />
        <div>
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('id-ID')}</time>
          <h2><a href={`${base}blog/${post.data.slug || post.slug}/`}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
        </div>
      </article>
    ))}
  </div>
  {totalPages > 1 && <nav class="pagination" aria-label="Halaman artikel">
    {currentPage > 1 && <a href={href(currentPage - 1)} rel="prev">Sebelumnya</a>}
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => page === currentPage
      ? <span aria-current="page">{page}</span> : <a href={href(page)} aria-label={`Halaman ${page}`}>{page}</a>)}
    {currentPage < totalPages && <a href={href(currentPage + 1)} rel="next">Berikutnya</a>}
  </nav>}
</Base>
