---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../publication.js';
const allPosts = await getCollection('blog');
const published = allPosts.filter((post) => isPublished(post));
const drafts = allPosts.filter((post) => post.data.status === 'draft');
const previews = allPosts.filter((post) => post.data.status === 'preview');
const recent = [...allPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 8);
---
<Base title="Admin Dashboard | Java Mbako" description="Panel administrasi teknis Java Mbako." index={false}>
  <section class="admin-app">
    <aside class="sidebar">
      <a class="brand" href="/admin/dashboard/"><span class="brand-mark">JM</span><span><strong>Java Mbako</strong><small>ADMIN CONSOLE</small></span></a>
      <p class="nav-label">WORKSPACE</p>
      <a class="nav-item active" href="/admin/dashboard/"><span>▦</span> Dashboard</a>
      <a class="nav-item" href="https://github.com/adnanyogi88-dev/Javambako/tree/main/src/content/blog" target="_blank" rel="noopener noreferrer"><span>▤</span> Inventaris artikel <small>↗</small></a>
      <p class="nav-label">WEBSITE</p>
      <a class="nav-item" href="https://javatobacco.com/sitemap-index.xml" target="_blank" rel="noopener noreferrer"><span>⌁</span> Sitemap <small>↗</small></a>
      <a class="nav-item" href="https://github.com/adnanyogi88-dev/Javambako/tree/main/public" target="_blank" rel="noopener noreferrer"><span>▧</span> File publik <small>↗</small></a>
      <p class="nav-label">SYSTEM</p>
      <a class="nav-item" href="https://supabase.com/dashboard/project/xmbpzuwxfljrusjhvtor/auth/users" target="_blank" rel="noopener noreferrer"><span>♙</span> Akun & akses <small>↗</small></a>
      <a class="nav-item" href="https://github.com/adnanyogi88-dev/Javambako/actions" target="_blank" rel="noopener noreferrer"><span>◷</span> Build & deployment <small>↗</small></a>
      <div class="sidebar-bottom"><span class="status-dot"></span> Sistem terhubung ke GitHub<br/><small>Perubahan produksi melalui review</small></div>
    </aside>
    <main class="main-panel">
      <header class="topbar"><div><span class="crumb">Workspace /</span> Dashboard</div><div class="top-actions"><span class="environment">DEVELOPMENT</span><button id="logout" type="button">Keluar ↗</button></div></header>
      <div class="page-content">
        <div class="welcome"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p>Ringkasan teknis dan inventaris konten website.</p></div><a class="view-site" href="https://javatobacco.com/" target="_blank" rel="noopener noreferrer">Lihat website ↗</a></div>
        <div id="auth-status" class="auth-status" role="status" aria-live="polite">Memeriksa sesi administrator...</div>
        <div id="dashboard-content" hidden>
          <div class="welcome-user"><div class="avatar">A</div><div><strong id="admin-email">Administrator</strong><small>Akses administrator terverifikasi</small></div><span class="verified">● Terverifikasi</span></div>
          <div class="section-heading"><div><h2>Ikhtisar konten</h2><p>Jumlah berdasarkan data artikel pada repository saat build terakhir.</p></div></div>
          <div class="stats">
            <article class="stat-card"><span class="stat-icon">▤</span><small>Total artikel</small><strong>${allPosts.length}</strong><span class="stat-note">Semua status</span></article>
            <article class="stat-card"><span class="stat-icon green">✓</span><small>Terpublikasi</small><strong>${published.length}</strong><span class="stat-note">Termasuk jadwal aktif</span></article>
            <article class="stat-card"><span class="stat-icon amber">◷</span><small>Draft</small><strong>${drafts.length}</strong><span class="stat-note">Belum dipublikasikan</span></article>
            <article class="stat-card"><span class="stat-icon violet">◉</span><small>Preview</small><strong>${previews.length}</strong><span class="stat-note">Mode pratinjau</span></article>
          </div>
          <div class="section-heading"><div><h2>Aktivitas konten terbaru</h2><p>Daftar artikel berdasarkan tanggal yang tercatat.</p></div><a href="https://github.com/adnanyogi88-dev/Javambako/tree/main/src/content/blog" target="_blank" rel="noopener noreferrer">Buka repository ↗</a></div>
          <section class="panel"><div class="table-wrap"><table><thead><tr><th>JUDUL ARTIKEL</th><th>TANGGAL</th><th>STATUS</th></tr></thead><tbody>{recent.map((post) => <tr><td><strong>{post.data.title}</strong><small>{post.data.slug || post.slug}</small></td><td>{post.data.date.toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'})}</td><td><span class:list={['tag', post.data.status === 'published' ? 'published' : post.data.status === 'draft' ? 'draft' : 'preview']}>{post.data.status || 'published'}</span></td></tr>)}</tbody></table></div></section>
          <div class="section-heading"><div><h2>Pemeriksaan sistem</h2><p>Jalur cepat untuk memeriksa layanan yang digunakan website.</p></div></div>
          <div class="system-grid">
            <a class="system-card" href="https://github.com/adnanyogi88-dev/Javambako/actions" target="_blank" rel="noopener noreferrer"><span>◷</span><div><strong>GitHub Actions</strong><small>Periksa status build dan deployment</small></div><b>↗</b></a>
            <a class="system-card" href="https://supabase.com/dashboard/project/xmbpzuwxfljrusjhvtor" target="_blank" rel="noopener noreferrer"><span>◈</span><div><strong>Supabase</strong><small>Authentication dan database akses</small></div><b>↗</b></a>
            <a class="system-card" href="https://javatobacco.com/sitemap-index.xml" target="_blank" rel="noopener noreferrer"><span>⌁</span><div><strong>Sitemap website</strong><small>Periksa sitemap yang dipublikasikan</small></div><b>↗</b></a>
          </div>
          <p class="notice"><strong>Catatan keamanan:</strong> panel ini menampilkan ringkasan metadata artikel yang juga tersedia secara publik. Autentikasi membatasi tampilan panel, tetapi situs statis bukan tempat menyimpan data rahasia. Jangan menaruh token privat atau data sensitif di halaman ini.</p>
        </div>
      </div>
    </main>
  </section>
</Base>
<script>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  const status = document.querySelector('#auth-status');
  const content = document.querySelector('#dashboard-content');
  const logout = document.querySelector('#logout');
  const emailLabel = document.querySelector('#admin-email');
  if (!url || !key) {
    status.textContent = 'Konfigurasi Supabase belum tersedia. Hubungi pengelola sistem.';
  } else {
    const supabase = createClient(url, key);
    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();
      if (sessionError) throw sessionError;
      if (!session?.user) {
        window.location.replace('/admin/');
      } else {
        const { data: admin, error } = await supabase.from('admin_users').select('user_id').eq('user_id', session.user.id).maybeSingle();
        if (error || !admin) {
          await supabase.auth.signOut();
          window.location.replace('/admin/');
        } else {
          emailLabel.textContent = session.user.email || 'Administrator';
          status.hidden = true;
          content.hidden = false;
        }
      }
    } catch (error) {
      status.textContent = 'Tidak dapat memverifikasi sesi. Muat ulang halaman atau coba login kembali.';
    }
    logout.addEventListener('click', async () => {
      logout.disabled = true;
      await supabase.auth.signOut();
      window.location.replace('/admin/');
    });
  }
</script>
