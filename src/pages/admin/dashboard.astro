---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../publication.js';
const allPosts = await getCollection('blog');
const published = allPosts.filter((post) => isPublished(post));
const drafts = allPosts.filter((post) => post.data.status === 'draft');
const previews = allPosts.filter((post) => post.data.status === 'preview');
const recent = [...allPosts].sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,12);
---
<Base title="Dashboard Admin | Java Mbako" description="Panel administrasi website Java Mbako." index={false}>
  <section class="admin-dashboard">
    <div class="dashboard-head"><div><p class="eyebrow">Panel administrasi</p><h1>Dashboard Java Mbako</h1><p>Ringkasan konten website. Perubahan artikel tetap dilakukan melalui repository agar proses publikasi tercatat.</p></div><button id="logout" type="button">Keluar</button></div>
    <p id="auth-status" role="status" aria-live="polite">Memeriksa sesi administrator...</p>
    <div id="dashboard-content" hidden>
      <div class="stats"><article><span>Total artikel</span><strong>{allPosts.length}</strong></article><article><span>Terpublikasi</span><strong>{published.length}</strong></article><article><span>Draft</span><strong>{drafts.length}</strong></article><article><span>Preview</span><strong>{previews.length}</strong></article></div>
      <section class="content-panel"><h2>Artikel terbaru</h2><div class="table-wrap"><table><thead><tr><th>Judul</th><th>Tanggal</th><th>Status</th></tr></thead><tbody>{recent.map((post) => <tr><td>{post.data.title}</td><td>{post.data.date.toLocaleDateString('id-ID')}</td><td>{post.data.status}</td></tr>)}</tbody></table></div></section>
      <section class="content-panel"><h2>Pengelolaan konten</h2><p>Untuk mengubah artikel, buka folder konten di GitHub. Setiap perubahan akan masuk melalui commit dan proses build sehingga URL artikel tetap terjaga.</p><a href="https://github.com/adnanyogi88-dev/Javambako/tree/main/src/content/blog" target="_blank" rel="noopener noreferrer">Buka folder artikel di GitHub</a></section>
    </div>
  </section>
</Base>
<script>
  import { createClient } from '@supabase/supabase-js';
  const url=import.meta.env.PUBLIC_SUPABASE_URL; const key=import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  const status=document.querySelector('#auth-status'); const content=document.querySelector('#dashboard-content'); const logout=document.querySelector('#logout');
  if(!url||!key) status.textContent='Konfigurasi Supabase belum dipasang pada environment deployment.';
  else {
    const supabase=createClient(url,key); const {data:{subscription}}=supabase.auth.onAuthStateChange(()=>{});
    const {data:sessionData}=await supabase.auth.getSession(); const user=sessionData.session?.user;
    if(!user) window.location.replace('/admin/');
    else {
      const {data:admin,error}=await supabase.from('admin_users').select('user_id').eq('user_id',user.id).maybeSingle();
      if(error||!admin){await supabase.auth.signOut();window.location.replace('/admin/');}
      else {status.textContent='Login sebagai '+user.email;content.hidden=false;}
    }
    logout.addEventListener('click',async()=>{await supabase.auth.signOut();window.location.replace('/admin/');});
    window.addEventListener('pagehide',()=>subscription.unsubscribe());
  }
</script>
<style>
.admin-dashboard{padding:48px 0 70px}.dashboard-head{display:flex;align-items:center;justify-content:space-between;gap:20px}.dashboard-head h1{font-size:38px;margin:8px 0}.dashboard-head p{color:var(--muted);max-width:700px}.dashboard-head button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:11px 18px;cursor:pointer}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:28px 0}.stats article,.content-panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px}.stats span{display:block;color:var(--muted);font-size:14px}.stats strong{display:block;font-size:30px;margin-top:8px}.content-panel{margin-top:18px}.content-panel h2{margin-top:0}.content-panel p{color:var(--muted)}.content-panel a{color:var(--brand);font-weight:700}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line)}#auth-status{color:var(--muted)}@media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}.dashboard-head{align-items:flex-start;flex-direction:column}.dashboard-head h1{font-size:30px}}
</style>